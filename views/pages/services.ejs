<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <style>
        .services-hero {
            padding: 180px 0 100px;
            background: linear-gradient(135deg, var(--bg-light) 0%, #e2e8f0 100%);
            border-bottom: 1px solid var(--glass-border);
            text-align: center;
        }
        .category-block {
            margin-bottom: 80px;
        }
        .category-block:last-child {
            margin-bottom: 0;
        }
        .category-header-wrap {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 36px;
            border-bottom: 2px solid var(--primary-light);
            padding-bottom: 16px;
        }
        .category-icon-circle {
            background: var(--primary);
            color: white;
            width: 50px;
            height: 50px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            box-shadow: var(--shadow-sm);
        }
        .category-header-wrap h2 {
            font-size: 1.75rem;
            color: var(--primary-dark);
            margin: 0;
            font-weight: 700;
        }
        .service-item-card {
            background: var(--bg-surface);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            padding: 30px;
            box-shadow: var(--shadow-sm);
            text-decoration: none;
            transition: all var(--transition-normal);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 220px;
        }
        .service-item-card:hover {
            transform: translateY(-6px);
            border-color: var(--primary);
            box-shadow: var(--shadow-lg);
            text-decoration: none;
        }
        .service-item-card h4 {
            font-size: 1.15rem;
            color: var(--primary-dark);
            font-weight: 700;
            margin-bottom: 12px;
            transition: color var(--transition-fast);
        }
        .service-item-card:hover h4 {
            color: var(--primary);
        }
        .service-item-card p {
            font-size: 0.9rem;
            color: var(--text-secondary);
            line-height: 1.5;
            margin-bottom: 20px;
            flex-grow: 1;
        }
        .service-read-more {
            font-size: 0.825rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .service-read-more i {
            transition: transform var(--transition-fast);
        }
        .service-item-card:hover .service-read-more i {
            transform: translateX(4px);
        }
    </style>
</head>
<body data-page="services">

    <%- include('../partials/header') %>

    <!-- Beautiful Services Hero -->
    <section class="services-hero">
        <div class="container animate-on-scroll">
            <span class="subtitle">Capabilities</span>
            <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; color: var(--primary-dark); line-height: 1.1; margin-bottom: 20px;">
                Our Services & Offerings
            </h1>
            <p style="font-size: 1.2rem; color: var(--text-secondary); max-width: 800px; margin: 0 auto; line-height: 1.6;">
                Comprehensive custom software engineering, dedicated web designing, robust API communication tools, and certified cloud hosting.
            </p>
        </div>
    </section>

    <!-- Services Categories List -->
    <section class="section-padding-lg" style="background: var(--bg-surface);">
        <div class="container">
            
            <!-- Category 1: Software & Web Development -->
            <div class="category-block animate-on-scroll">
                <div class="category-header-wrap">
                    <div class="category-icon-circle"><i class="fas fa-code"></i></div>
                    <h2>Software & Web Development</h2>
                </div>
                <div class="grid grid-cols-3" style="gap: 30px;">
                    <a href="/services/web-development" class="service-item-card">
                        <div>
                            <h4>Web Design & Development</h4>
                            <p>Modern, responsive, and user-centric websites optimized to express your brand identity and maximize client conversions.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/web-application" class="service-item-card">
                        <div>
                            <h4>Web Application Development</h4>
                            <p>Custom web-based applications and administration portals engineered to streamline operations and automate workflows.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/custom-software" class="service-item-card">
                        <div>
                            <h4>Custom Software Development</h4>
                            <p>Bespoke system designs built precisely around your operational models using ASP.NET, C#, PHP, and SQL Server.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/app-development" class="service-item-card">
                        <div>
                            <h4>Mobile App Development</h4>
                            <p>User-friendly, custom mobile apps for iOS and Android built on native and Flutter cross-platform frameworks.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
            </div>

            <!-- Category 2: Digital Marketing -->
            <div class="category-block animate-on-scroll">
                <div class="category-header-wrap">
                    <div class="category-icon-circle"><i class="fas fa-bullhorn"></i></div>
                    <h2>Digital Marketing</h2>
                </div>
                <div class="grid grid-cols-3" style="gap: 30px;">
                    <a href="/services/digital-marketing" class="service-item-card">
                        <div>
                            <h4>Digital Marketing Strategy</h4>
                            <p>Data-driven brand strategies, local audience promotion, and continuous acquisition channels optimized to achieve ROI.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/seo-services" class="service-item-card">
                        <div>
                            <h4>SEO & Search Engine Optimization</h4>
                            <p>Rank higher in organic search result hierarchies, optimize crawl structures, and target major local search queries.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/smo" class="service-item-card">
                        <div>
                            <h4>Social Media Optimization (SMO)</h4>
                            <p>Build, manage, and scale organic brand handles across Facebook, Instagram, and major networks to boost active audiences.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/google-adwords" class="service-item-card">
                        <div>
                            <h4>Google AdWords PPC Management</h4>
                            <p>Capture high-value transactional leads instantly through programmatic PPC, targeted keywords, and ad budget controls.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
            </div>

            <!-- Category 3: Data Analytics -->
            <div class="category-block animate-on-scroll">
                <div class="category-header-wrap">
                    <div class="category-icon-circle"><i class="fas fa-chart-bar"></i></div>
                    <h2>Data Analytics</h2>
                </div>
                <div class="grid grid-cols-3" style="gap: 30px;">
                    <a href="/services/power-bi" class="service-item-card">
                        <div>
                            <h4>Power BI & Data Analytics</h4>
                            <p>Transform raw siloed records into custom Business Intelligence (BI) dashboards using smart DAX integrations from EMR, HIS, CRM & ERP servers.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
            </div>

            <!-- Category 3: Communication APIs -->
            <div class="category-block animate-on-scroll">
                <div class="category-header-wrap">
                    <div class="category-icon-circle"><i class="fas fa-comments"></i></div>
                    <h2>Communication APIs</h2>
                </div>
                <div class="grid grid-cols-3" style="gap: 30px;">
                    <a href="/services/whatsapp-api" class="service-item-card">
                        <div>
                            <h4>WhatsApp Business API</h4>
                            <p>Integrate Meta's official API to handle customer support chats, transaction invoices, and smart NLP chatbots automatically.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/bulk-sms" class="service-item-card">
                        <div>
                            <h4>Bulk SMS & SMS API</h4>
                            <p>Transactional OTP APIs and promotional campaign panels featuring direct high-throughput carrier routing and DLT compliance.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/cloud-ivr" class="service-item-card">
                        <div>
                            <h4>Cloud IVR Telephony</h4>
                            <p>Auto-attendant interactive voice menus, call recordings, and virtual numbers with zero expensive hardware requirement.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/rcs" class="service-item-card">
                        <div>
                            <h4>Rich Business Messaging (RCS)</h4>
                            <p>Send verified sender-ID messages featuring action buttons and high-res media carousels inside standard phone messaging client.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/ai-contact-center" class="service-item-card">
                        <div>
                            <h4>AI Contact Center Automation</h4>
                            <p>AI support bots resolving caller intents instantly across email, chat, and telephony in a centralized omnichannel desk.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
            </div>

            <!-- Category 3: Cloud & Hosting -->
            <div class="category-block animate-on-scroll">
                <div class="category-header-wrap">
                    <div class="category-icon-circle"><i class="fas fa-cloud"></i></div>
                    <h2>Cloud & Hosting Services</h2>
                </div>
                <div class="grid grid-cols-3" style="gap: 30px;">
                    <a href="/services/azure-cloud" class="service-item-card">
                        <div>
                            <h4>Azure Cloud Server</h4>
                            <p>Deploy databases and cloud computing resources securely on Microsoft Azure with custom network firewall safeguards.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/aws-cloud" class="service-item-card">
                        <div>
                            <h4>AWS Cloud Server Hosting</h4>
                            <p>Maintain highly scalable AWS environments engineered for maximum uptime, high traffic spikes, and secure storage backups.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/google-cloud" class="service-item-card">
                        <div>
                            <h4>Google Cloud Platform</h4>
                            <p>Leverage GCP Compute Engine and Google Storage buckets for fast operations on Google's global fiber network.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/linux-hosting" class="service-item-card">
                        <div>
                            <h4>Linux Managed Hosting</h4>
                            <p>Stable, hardened virtual and bare-metal servers optimized for PHP, WordPress, Nginx, and Apache environments.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/windows-hosting" class="service-item-card">
                        <div>
                            <h4>Windows Managed Hosting</h4>
                            <p>Configured IIS servers, Active Directory federation, and MS SQL Server setups built specifically for C# and .NET deployments.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
            </div>

            <!-- Category 4: Business CRM & Email -->
            <div class="category-block animate-on-scroll">
                <div class="category-header-wrap">
                    <div class="category-icon-circle"><i class="fas fa-envelope-open-text"></i></div>
                    <h2>Business CRM & Email</h2>
                </div>
                <div class="grid grid-cols-3" style="gap: 30px;">
                    <a href="/services/microsoft-365" class="service-item-card">
                        <div>
                            <h4>Microsoft 365 Migration</h4>
                            <p>Coordinate secure domain migrations, Exchange email accounts, MS Teams networks, and SharePoint intranets with zero data loss.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/zoho-crm" class="service-item-card">
                        <div>
                            <h4>Zoho CRM Custom Implementation</h4>
                            <p>Custom sales pipeline structuring, workflow Deluge scripting, and operational database synchronization for B2B tracking.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/zoho-email" class="service-item-card">
                        <div>
                            <h4>Zoho Email & Mail Suite</h4>
                            <p>Professional domain business email setups optimized with SPF, DKIM, and DMARC alignment for high-deliverability ratings.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/google-workspace" class="service-item-card">
                        <div>
                            <h4>Google Workspace Setup</h4>
                            <p>Google Workspace domain administration, shared G Drive storage perimeters, and Chrome Enterprise security management.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/zimbra-email" class="service-item-card">
                        <div>
                            <h4>On-Premise Zimbra Server</h4>
                            <p>Defense-grade private email hosting on physical on-premise hardware for organizations demanding absolute data sovereignty.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
            </div>

            <!-- Category 5: Specialized Products -->
            <div class="category-block animate-on-scroll" style="margin-bottom: 0;">
                <div class="category-header-wrap">
                    <div class="category-icon-circle"><i class="fas fa-box-open"></i></div>
                    <h2>Our Specialized Products</h2>
                </div>
                <div class="grid grid-cols-3" style="gap: 30px;">
                    <a href="/services/gst-billing" class="service-item-card">
                        <div>
                            <h4>GST Billing & Invoicing Software</h4>
                            <p>Fully compliant e-invoicing portals, real-time government tax syncing, accounting tools, and inventory control setups.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/asset-management" class="service-item-card">
                        <div>
                            <h4>Asset + ESM Management</h4>
                            <p>Automated system network discoveries, software licensing auditors, depreciations calculators, and live compliance CMDBs.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/complaint-management" class="service-item-card">
                        <div>
                            <h4>Online Complaint Management</h4>
                            <p>ITIL helpdesk ticket routing, SLA resolution duration alerts, multi-level escalation arrays, and analytical support desks.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/signage-cloud" class="service-item-card">
                        <div>
                            <h4>Cloud Signage Web Application</h4>
                            <p>Manage and stream playlist content to global TV screens dynamically using Split-Screen Layout Builders, live media feeds, and offline caching playback layers.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                    <a href="/services/queue-management" class="service-item-card">
                        <div>
                            <h4>Queue Management System (QMS)</h4>
                            <p>Streamline outpatient flows inside hospitals using custom touchscreen self-service check-in kiosks integrated directly with HIS & EMR systems, multi-screen queue signages, and voice token announcers.</p>
                        </div>
                        <div class="service-read-more">Learn More <i class="fas fa-arrow-right"></i></div>
                    </a>
                </div>
            </div>

        </div>
    </section>

    <%- include('../partials/footer') %>
    <%- include('../partials/whatsapp') %>

    <script src="/js/main.js"></script>
</body>
</html>
