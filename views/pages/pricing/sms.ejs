<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/head') %>
    <style>
        .pricing-hero {
            padding: 80px 0 60px;
            background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-light) 100%);
            text-align: center;
        }
        
        .pricing-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .pricing-header h1 {
            font-size: 2.8rem;
            color: var(--primary-dark);
            margin-bottom: 20px;
            font-weight: 800;
        }

        .pricing-header p {
            font-size: 1.25rem;
            color: var(--text-secondary);
            max-width: 700px;
            margin: 0 auto 50px;
        }

        .pricing-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: -30px;
            padding-bottom: 80px;
        }

        .pricing-card {
            background: white;
            border-radius: 16px;
            padding: 40px;
            box-shadow: var(--shadow-lg);
            text-align: left;
            position: relative;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .pricing-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }

        .pricing-card.popular {
            border: 2px solid var(--primary);
            transform: scale(1.05);
            z-index: 1;
        }

        .pricing-card.popular:hover {
            transform: scale(1.05) translateY(-10px);
        }

        .popular-badge {
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--primary);
            color: white;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .plan-name {
            font-size: 1.5rem;
            color: var(--primary-dark);
            margin-bottom: 15px;
            font-weight: 700;
        }

        .plan-desc {
            color: var(--text-secondary);
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .plan-price {
            font-size: 3rem;
            color: var(--primary);
            font-weight: 800;
            margin-bottom: 10px;
        }

        .plan-price span {
            font-size: 1.2rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .plan-features {
            list-style: none;
            padding: 0;
            margin: 30px 0;
        }

        .plan-features li {
            padding: 12px 0;
            color: var(--text-primary);
            border-bottom: 1px solid #f1f3f5;
            display: flex;
            align-items: center;
        }

        .plan-features li::before {
            content: '✓';
            color: #2e7d32;
            font-weight: bold;
            margin-right: 12px;
            font-size: 1.2rem;
        }

        .btn-pricing {
            display: block;
            text-align: center;
            background: white;
            color: var(--primary);
            padding: 15px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            border: 2px solid var(--primary);
        }

        .btn-pricing.primary {
            background: var(--primary);
            color: white;
            border: none;
        }

        .btn-pricing:hover {
            background: var(--primary-dark);
            color: white;
        }

        /* Call to Action */
        .cta-section {
            background: var(--primary-dark);
            padding: 80px 0;
            text-align: center;
            color: white;
        }

        .cta-section h2 {
            font-size: 2.5rem;
            margin-bottom: 20px;
        }

        .cta-section p {
            font-size: 1.2rem;
            opacity: 0.9;
            max-width: 600px;
            margin: 0 auto 40px;
        }

        .btn-cta {
            display: inline-block;
            background: white;
            color: var(--primary-dark);
            padding: 15px 40px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.1rem;
            transition: transform 0.3s ease;
        }

        .btn-cta:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }

        @media (max-width: 768px) {
            .pricing-card.popular {
                transform: none;
            }
            .pricing-card.popular:hover {
                transform: translateY(-10px);
            }
        }
    </style>
</head>
<body data-page="pricing">
    <%- include('../../partials/header') %>

    <main>
        <section class="pricing-hero">
            <div class="pricing-container">
                <div class="pricing-header">
                    <h1>Bulk SMS Pricing Plans</h1>
                    <p>Transparent, volume-based pricing for businesses of all sizes. Deliver your messages instantly with our enterprise-grade SMS API.</p>
                </div>
            </div>
        </section>

        <section style="background: white;">
            <div class="pricing-container">
                <div class="pricing-cards">
                    <!-- Starter Plan -->
                    <div class="pricing-card">
                        <div class="plan-name">Starter</div>
                        <div class="plan-desc">Perfect for small businesses starting their SMS marketing.</div>
                        <div class="plan-price">₹0.15<span>/ SMS</span></div>
                        <ul class="plan-features">
                            <li>10,000 SMS Credits</li>
                            <li>Transactional & Promotional Route</li>
                            <li>Standard Delivery Speed</li>
                            <li>Basic Analytics Report</li>
                            <li>Email Support</li>
                        </ul>
                        <a href="/contact" class="btn-pricing">Get Started</a>
                    </div>

                    <!-- Professional Plan -->
                    <div class="pricing-card popular">
                        <div class="popular-badge">Most Popular</div>
                        <div class="plan-name">Business</div>
                        <div class="plan-desc">Ideal for growing companies with regular messaging needs.</div>
                        <div class="plan-price">₹0.12<span>/ SMS</span></div>
                        <ul class="plan-features">
                            <li>100,000 SMS Credits</li>
                            <li>High Priority Delivery Route</li>
                            <li>DLT Registration Support</li>
                            <li>Advanced Analytics Dashboard</li>
                            <li>API Integration Access</li>
                        </ul>
                        <a href="/contact" class="btn-pricing primary">Choose Business</a>
                    </div>

                    <!-- Enterprise Plan -->
                    <div class="pricing-card">
                        <div class="plan-name">Enterprise</div>
                        <div class="plan-desc">For large-scale operations requiring maximum performance.</div>
                        <div class="plan-price">Custom</div>
                        <ul class="plan-features">
                            <li>1 Million+ SMS Credits</li>
                            <li>Dedicated High-Speed Route</li>
                            <li>Dedicated Account Manager</li>
                            <li>Custom API Solutions</li>
                            <li>SLA Guarantee</li>
                        </ul>
                        <a href="/contact" class="btn-pricing">Contact Sales</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="cta-section">
            <div class="pricing-container">
                <h2>Need Global SMS Coverage?</h2>
                <p>We provide global SMS routing to over 200+ countries with competitive pricing and unparalleled deliverability.</p>
                <a href="/contact" class="btn-cta">Talk to our Sales Team</a>
            </div>
        </section>
    </main>

    <%- include('../../partials/footer') %>
    <%- include('../../partials/whatsapp') %>
    <script src="/js/main.js"></script>
</body>
</html>
