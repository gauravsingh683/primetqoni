<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body data-page="book-demo">

    <%- include('../partials/header') %>

    <section class="contact-hero" style="padding-bottom: 40px;">
        <div class="container animate-on-scroll">
            <h1>Book a Demo</h1>
            <p>See our solutions in action. Schedule a personalized demo with our experts.</p>
        </div>
    </section>

    <section class="section-padding-lg">
        <div class="container" style="max-width: 800px;">
            <div class="contact-form-wrapper animate-on-scroll delay-200">
                <form action="/api/book-demo" method="POST" class="ajax-form">
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label style="color: var(--text-secondary); margin-bottom: 8px; display: block;">Full Name *</label>
                            <input type="text" name="name" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label style="color: var(--text-secondary); margin-bottom: 8px; display: block;">Email Address *</label>
                            <input type="email" name="email" class="form-control" required>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label style="color: var(--text-secondary); margin-bottom: 8px; display: block;">Phone Number *</label>
                            <input type="tel" name="phone" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label style="color: var(--text-secondary); margin-bottom: 8px; display: block;">Company Name</label>
                            <input type="text" name="company" class="form-control">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label style="color: var(--text-secondary); margin-bottom: 8px; display: block;">Interested In</label>
                            <select name="service" class="form-control">
                                <option value="" disabled selected>Select a Product/Service</option>
                                <option value="GST Billing Software">GST Billing Software</option>
                                <option value="Asset + ESM Management">Asset + ESM Management</option>
                                <option value="Complaint Management">Complaint Management</option>
                                <option value="Custom Software">Custom Software Solutions</option>
                                <option value="WhatsApp/SMS APIs">WhatsApp/SMS APIs</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label style="color: var(--text-secondary); margin-bottom: 8px; display: block;">Preferred Date</label>
                            <input type="date" name="preferredDate" class="form-control" min="<%= new Date().toISOString().split('T')[0] %>">
                        </div>
                    </div>

                    <div class="form-group">
                        <label style="color: var(--text-secondary); margin-bottom: 8px; display: block;">Additional Requirements or Questions</label>
                        <textarea name="message" class="form-control" style="min-height: 100px;"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100" style="width: 100%; margin-top: 16px;">
                        <span class="btn-text">Schedule My Demo</span>
                        <span class="btn-loader" style="display: none;"><i class="fas fa-spinner fa-spin"></i> Submitting...</span>
                    </button>

                    <div class="form-status"></div>
                </form>
            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>
    <%- include('../partials/whatsapp') %>

    <script src="/js/main.js"></script>
</body>
</html>
