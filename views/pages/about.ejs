<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <style>
        .about-hero {
            padding: 180px 0 100px;
            background: linear-gradient(135deg, var(--bg-light) 0%, #e2e8f0 100%);
            border-bottom: 1px solid var(--glass-border);
            position: relative;
            text-align: center;
        }
        .about-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 50% 50%, rgba(37, 99, 235, 0.05) 0%, transparent 70%);
            pointer-events: none;
        }
        .about-intro-section {
            padding: 100px 0;
            background: var(--bg-surface);
        }
        .about-grid-img {
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-xl);
            border: 4px solid var(--bg-surface);
            transition: transform var(--transition-slow);
            width: 100%;
            object-fit: cover;
            height: 480px;
        }
        .about-grid-img:hover {
            transform: translateY(-8px);
        }
        .vision-mission-section {
            padding: 100px 0;
            background: var(--bg-light);
            border-top: 1px solid var(--glass-border);
            border-bottom: 1px solid var(--glass-border);
        }
        .vm-card {
            background: var(--bg-surface);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            padding: 40px;
            box-shadow: var(--shadow-sm);
            height: 100%;
            transition: all var(--transition-normal);
        }
        .vm-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
            box-shadow: var(--shadow-md);
        }
        .mission-list {
            list-style: none;
            padding: 0;
            margin: 24px 0 0;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .mission-list li {
            display: flex;
            gap: 12px;
            font-size: 0.95rem;
            color: var(--text-secondary);
            line-height: 1.5;
            align-items: flex-start;
        }
        .mission-list li i {
            color: var(--primary);
            margin-top: 4px;
        }
        .what-we-do-section {
            padding: 100px 0;
            background: var(--bg-surface);
        }
        .do-card {
            background: var(--bg-surface);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            padding: 30px;
            box-shadow: var(--shadow-sm);
            transition: all var(--transition-normal);
        }
        .do-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
            box-shadow: var(--shadow-md);
        }
        .why-choose-section {
            padding: 100px 0;
            background: var(--bg-light);
            border-top: 1px solid var(--glass-border);
        }
        .choose-grid {
            display: grid;
            grid-template-cols: repeat(3, 1fr);
            gap: 30px;
            margin-top: 50px;
        }
        .choose-item {
            display: flex;
            gap: 16px;
            background: var(--bg-surface);
            padding: 24px;
            border-radius: var(--radius-md);
            border: 1px solid var(--glass-border);
            transition: all var(--transition-normal);
        }
        .choose-item:hover {
            border-color: var(--primary);
            box-shadow: var(--shadow-md);
            transform: translateY(-3px);
        }
        .choose-icon {
            color: var(--primary);
            font-size: 1.5rem;
            margin-top: 3px;
        }
        .commitment-banner {
            background: linear-gradient(135deg, rgba(37,99,235,0.03) 0%, rgba(6,182,212,0.03) 100%);
            border: 1px solid var(--glass-border);
            border-left: 4px solid var(--primary);
            padding: 40px;
            border-radius: var(--radius-lg);
            margin-top: 80px;
            box-shadow: var(--shadow-sm);
        }
    </style>
</head>
<body data-page="about">

    <%- include('../partials/header') %>

    <!-- Sleek About Hero -->
    <section class="about-hero">
        <div class="container animate-on-scroll">
            <span class="subtitle">About Primetroniq Innovations</span>
            <h1 style="font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 800; color: var(--primary-dark); line-height: 1.2; margin-bottom: 24px; max-width: 900px; margin-left: auto; margin-right: auto;">
                “Innovative IT Solutions. Reliable Technology. Sustainable Growth.”
            </h1>
            <p style="font-size: 1.15rem; color: var(--text-secondary); max-width: 800px; line-height: 1.6; margin: 0 auto;">
                Empowering startups, SMEs, and enterprises globally with high-quality customized software engineering and structured IT consultancies.
            </p>
        </div>
    </section>

    <!-- Company Overview -->
    <section class="about-intro-section">
        <div class="container">
            <div class="grid grid-cols-2" style="align-items: center; gap: 80px;">
                <div class="animate-on-scroll">
                    <span class="subtitle">Who We Are</span>
                    <h2 style="font-size: 2.25rem; color: var(--primary-dark); margin-bottom: 24px; font-weight: 800;">Strategic Technology Partner</h2>
                    
                    <p style="font-size: 1.05rem; line-height: 1.6; color: var(--text-primary); margin-bottom: 20px; font-weight: 500;">
                        Primetroniq Innovations is a technology-driven IT solutions and digital services company focused on delivering reliable, secure, and scalable technology solutions for businesses of all sizes.
                    </p>
                    <p style="font-size: 0.95rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 20px;">
                        We help organizations modernize their IT infrastructure, optimize operations, and strengthen their digital presence through innovative and result-oriented solutions. With a strong foundation in IT infrastructure management, cloud services, software and web application development, digital marketing, and data analytics, we act as a strategic technology partner for our clients.
                    </p>
                    <p style="font-size: 0.95rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 0;">
                        Our goal is to simplify complex technology challenges and transform them into efficient, business-friendly solutions. At Primetroniq Innovations, we believe technology should empower businesses—not complicate them. We work closely with our clients to understand their business requirements, challenges, and long-term goals, enabling us to deliver customized solutions that drive measurable growth and operational excellence.
                    </p>
                </div>
                
                <div class="animate-on-scroll delay-200">
                    <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=800&q=80" alt="Primetroniq Innovations Collaborative Team Working" class="about-grid-img">
                </div>
            </div>
        </div>
    </section>

    <!-- Vision & Mission -->
    <section class="vision-mission-section">
        <div class="container">
            <div class="grid grid-cols-2" style="gap: 50px;">
                <!-- Vision -->
                <div class="animate-on-scroll">
                    <div class="vm-card">
                        <div class="icon-box" style="margin-bottom: 24px; background: rgba(37,99,235,0.1); color: var(--primary);"><i class="fas fa-eye" style="font-size: 1.5rem;"></i></div>
                        <h3 style="font-size: 1.75rem; color: var(--primary-dark); margin-bottom: 20px; font-weight: 800;">Our Vision</h3>
                        <p style="font-size: 1.05rem; line-height: 1.6; color: var(--text-secondary); margin: 0;">
                            To become a trusted and preferred technology partner for businesses by delivering innovative, secure, and high-quality IT and digital solutions that enable sustainable growth and digital excellence.
                        </p>
                    </div>
                </div>

                <!-- Mission -->
                <div class="animate-on-scroll delay-200">
                    <div class="vm-card">
                        <div class="icon-box" style="margin-bottom: 24px; background: rgba(6,182,212,0.1); color: var(--accent);"><i class="fas fa-bullseye" style="font-size: 1.5rem;"></i></div>
                        <h3 style="font-size: 1.75rem; color: var(--primary-dark); margin-bottom: 20px; font-weight: 800;">Our Mission</h3>
                        <ul class="mission-list">
                            <li><i class="fas fa-check-circle"></i> To empower businesses with scalable, secure, and future-ready IT infrastructure.</li>
                            <li><i class="fas fa-check-circle"></i> To deliver high-quality software, web, and cloud solutions tailored to business needs.</li>
                            <li><i class="fas fa-check-circle"></i> To simplify technology through smart automation and digital transformation.</li>
                            <li><i class="fas fa-check-circle"></i> To enhance brand visibility and growth through strategic digital marketing solutions.</li>
                            <li><i class="fas fa-check-circle"></i> To build long-term client relationships based on trust, transparency, and performance.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- What We Do -->
    <section class="what-we-do-section">
        <div class="container">
            <div class="section-header">
                <span class="subtitle">Our Capabilities</span>
                <h2>What We Do</h2>
                <p>We offer end-to-end IT and digital services that cover every aspect of modern business technology.</p>
            </div>

            <div class="grid grid-cols-3" style="gap: 30px; margin-top: 50px;">
                <!-- Item 1 -->
                <div class="do-card animate-on-scroll">
                    <div class="icon-box" style="margin-bottom: 20px;"><i class="fas fa-laptop-code"></i></div>
                    <h3 style="font-size: 1.25rem; color: var(--primary-dark); margin-bottom: 12px; font-weight: 700;">Software & Web Apps</h3>
                    <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; margin: 0;">
                        Custom web applications, ERP/CRM solutions, mobile apps, and structured business workflow automation.
                    </p>
                </div>

                <!-- Item 2 -->
                <div class="do-card animate-on-scroll delay-100">
                    <div class="icon-box" style="margin-bottom: 20px;"><i class="fas fa-paint-brush"></i></div>
                    <h3 style="font-size: 1.25rem; color: var(--primary-dark); margin-bottom: 12px; font-weight: 700;">Website Design & Branding</h3>
                    <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; margin: 0;">
                        Corporate websites, e-commerce platforms, custom UI/UX design, and ongoing website maintenance.
                    </p>
                </div>

                <!-- Item 3 -->
                <div class="do-card animate-on-scroll delay-200">
                    <div class="icon-box" style="margin-bottom: 20px;"><i class="fas fa-cloud"></i></div>
                    <h3 style="font-size: 1.25rem; color: var(--primary-dark); margin-bottom: 12px; font-weight: 700;">Cloud & IT Infrastructure</h3>
                    <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; margin: 0;">
                        Cloud migration, server hosting, virtualization, robust network designs, and infrastructure consulting.
                    </p>
                </div>

                <!-- Item 4 -->
                <div class="do-card animate-on-scroll">
                    <div class="icon-box" style="margin-bottom: 20px;"><i class="fas fa-comments"></i></div>
                    <h3 style="font-size: 1.25rem; color: var(--primary-dark); margin-bottom: 12px; font-weight: 700;">Email & Communication</h3>
                    <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; margin: 0;">
                        Microsoft 365, Zoho Mail, secure email deployments, and transactional enterprise communications setup.
                    </p>
                </div>

                <!-- Item 5 -->
                <div class="do-card animate-on-scroll delay-100">
                    <div class="icon-box" style="margin-bottom: 20px;"><i class="fas fa-bullhorn"></i></div>
                    <h3 style="font-size: 1.25rem; color: var(--primary-dark); margin-bottom: 12px; font-weight: 700;">Digital Marketing & SEO</h3>
                    <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; margin: 0;">
                        SEO, social media marketing, Google Business optimizations, paid PPC campaigns, and content strategies.
                    </p>
                </div>

                <!-- Item 6 -->
                <div class="do-card animate-on-scroll delay-200">
                    <div class="icon-box" style="margin-bottom: 20px;"><i class="fas fa-chart-bar"></i></div>
                    <h3 style="font-size: 1.25rem; color: var(--primary-dark); margin-bottom: 12px; font-weight: 700;">Data Analytics & BI</h3>
                    <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; margin: 0;">
                        Power BI dashboards and reporting for smarter, real-time data-driven business decisions.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="why-choose-section">
        <div class="container">
            <div class="grid grid-cols-2" style="align-items: center; gap: 80px;">
                <div class="animate-on-scroll">
                    <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80" alt="Data Analytics and Technical Consulting" class="about-grid-img">
                </div>

                <div class="animate-on-scroll delay-200">
                    <span class="subtitle">Our Edge</span>
                    <h2 style="font-size: 2.25rem; color: var(--primary-dark); margin-bottom: 24px; font-weight: 800;">Why Choose Us</h2>
                    <p style="color: var(--text-secondary); margin-bottom: 30px; line-height: 1.6;">
                        Primetroniq Innovations provides businesses with secure, highly scalable, and custom-tailored solutions designed strictly around your workflows.
                    </p>

                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div class="choose-item">
                            <i class="fas fa-user-tie choose-icon"></i>
                            <div>
                                <h4 style="font-size: 1rem; color: var(--primary-dark); margin-bottom: 6px; font-weight: 700;">Experienced IT Professionals</h4>
                                <p style="font-size: 0.875rem; color: var(--text-secondary); margin: 0; line-height: 1.4;">Skilled engineers, developers, and consultants working to build your solutions.</p>
                            </div>
                        </div>

                        <div class="choose-item">
                            <i class="fas fa-cubes choose-icon"></i>
                            <div>
                                <h4 style="font-size: 1rem; color: var(--primary-dark); margin-bottom: 6px; font-weight: 700;">End-to-End Solutions</h4>
                                <p style="font-size: 0.875rem; color: var(--text-secondary); margin: 0; line-height: 1.4;">Software, cloud servers, telephony APIs, and digital marketing under one roof.</p>
                            </div>
                        </div>

                        <div class="choose-item">
                            <i class="fas fa-lock choose-icon"></i>
                            <div>
                                <h4 style="font-size: 1rem; color: var(--primary-dark); margin-bottom: 6px; font-weight: 700;">Security & Reliability</h4>
                                <p style="font-size: 0.875rem; color: var(--text-secondary); margin: 0; line-height: 1.4;">A strong, continuous focus on system security, high performance, and uptime.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Our Commitment Banner -->
            <div class="commitment-banner animate-on-scroll">
                <h3 style="font-size: 1.5rem; color: var(--primary-dark); margin-bottom: 12px; font-weight: 800;">Our Commitment</h3>
                <p style="font-size: 1.05rem; line-height: 1.6; color: var(--text-secondary); margin: 0;">
                    We are committed to delivering technology solutions that add real business value. By combining technical expertise with strategic thinking, Primetroniq Innovations ensures that every client receives solutions that are practical, scalable, and aligned with future growth.
                </p>
            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>
    <%- include('../partials/whatsapp') %>

    <script src="/js/main.js"></script>
</body>
</html>
