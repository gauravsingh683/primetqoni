<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="ie=edge">

<title><%= typeof title !== 'undefined' ? title : 'Primetroniq Innovations' %></title>
<meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Creative Software Development & Website Designing Company' %>">
<% if (typeof keywords !== 'undefined') { %>
<meta name="keywords" content="<%= keywords %>">
<% } %>

<link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://primetroniqinnovations.com/' %>">

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website">
<meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://primetroniqinnovations.com/' %>">
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Primetroniq Innovations' %>">
<meta property="og:description" content="<%= typeof description !== 'undefined' ? description : '' %>">
<meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : '/assets/images/logo.png' %>">

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image">
<meta property="twitter:url" content="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://primetroniqinnovations.com/' %>">
<meta property="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Primetroniq Innovations' %>">
<meta property="twitter:description" content="<%= typeof description !== 'undefined' ? description : '' %>">
<meta property="twitter:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : '/assets/images/logo.png' %>">

<!-- Favicon -->
<link rel="icon" type="image/png" href="/assets/images/logo.png">

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<!-- Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<!-- Core CSS -->
<link rel="stylesheet" href="/css/variables.css">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/components.css">
<link rel="stylesheet" href="/css/layout.css">
<link rel="stylesheet" href="/css/animations.css">

<!-- Page Specific CSS -->
<% if (typeof pageCss !== 'undefined' && pageCss) { %>
<link rel="stylesheet" href="/css/pages/<%= pageCss %>.css">
<% } %>

<!-- Responsive CSS (Load last) -->
<link rel="stylesheet" href="/css/responsive.css">

<!-- Schema.org Markup -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Primetroniq Innovations",
  "url": "https://primetroniqinnovations.com/",
  "logo": "https://primetroniqinnovations.com/assets/images/logo.png",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+91-9608069813",
    "contactType": "customer service",
    "email": "info@primetroniqinnovations.com"
  },
  "sameAs": [
    "https://www.facebook.com/primetroniqinnovations/",
    "https://www.instagram.com/primetroniqinnovations/"
  ]
}
</script>
