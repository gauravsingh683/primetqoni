<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

    <aside class="admin-sidebar">
        <div class="admin-logo">
            <img src="/assets/images/logo.png" alt="Logo">
        </div>
        <nav class="admin-nav">
            <a href="/admin"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/admin/settings" class="active"><i class="fas fa-cog"></i> SMTP Settings</a>
            <a href="/" target="_blank"><i class="fas fa-external-link-alt"></i> View Website</a>
        </nav>
        <div class="admin-user">
            Logged in as:<br>
            <strong><%= adminEmail %></strong><br><br>
            <a href="/admin/logout" style="color: #ef4444; text-decoration: none;"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </aside>

    <main class="admin-main">
        <header class="admin-header">
            <h2>SMTP Configuration</h2>
        </header>

        <div class="admin-content">
            
            <% if (success) { %>
                <div class="alert alert-success"><%= success %></div>
            <% } %>
            <% if (error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 32px;">
                
                <div class="admin-card">
                    <div class="admin-card-header">
                        <h3>Email Server Settings</h3>
                    </div>
                    <div style="padding: 24px;">
                        <form id="smtpForm">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                                <div class="form-group">
                                    <label>SMTP Host</label>
                                    <input type="text" name="host" id="host" class="form-control" value="<%= smtp.host %>" placeholder="e.g. smtp.gmail.com" required>
                                </div>
                                <div class="form-group">
                                    <label>SMTP Port</label>
                                    <input type="number" name="port" id="port" class="form-control" value="<%= smtp.port %>" placeholder="e.g. 587" required>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                                <div class="form-group">
                                    <label>Username (Email)</label>
                                    <input type="text" name="username" id="username" class="form-control" value="<%= smtp.username %>" required>
                                </div>
                                <div class="form-group">
                                    <label>Password / App Password</label>
                                    <input type="password" name="password" id="password" class="form-control" placeholder="<%= smtp.password ? 'Leave blank to keep current password' : 'Enter password' %>" <%= !smtp.password ? 'required' : '' %>>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
                                <div class="form-group">
                                    <label>From Email Address</label>
                                    <input type="email" name="from_email" id="from_email" class="form-control" value="<%= smtp.from_email %>" placeholder="info@primetroniqinnovations.com" required>
                                </div>
                                <div class="form-group" style="display: flex; align-items: center; padding-top: 25px;">
                                    <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                                        <input type="checkbox" name="secure" id="secure" value="true" <%= smtp.secure ? 'checked' : '' %>>
                                        Use SSL/TLS (True for port 465, False for 587)
                                    </label>
                                </div>
                            </div>

                            <div style="display: flex; gap: 16px;">
                                <button type="button" id="saveBtn" class="btn">Save Settings</button>
                                <button type="button" id="testBtn" class="btn" style="background: #475569;">Send Test Email</button>
                            </div>
                            <div id="statusMsg" style="margin-top: 16px; font-weight: 500;"></div>
                        </form>
                    </div>
                </div>

                <div class="admin-card" style="height: fit-content;">
                    <div class="admin-card-header">
                        <h3>Instructions</h3>
                    </div>
                    <div style="padding: 24px; font-size: 14px; line-height: 1.6; color: var(--admin-text-secondary);">
                        <p><strong>For Gmail / Google Workspace:</strong></p>
                        <ul style="padding-left: 20px; margin-bottom: 20px;">
                            <li>Host: smtp.gmail.com</li>
                            <li>Port: 587</li>
                            <li>Secure: Unchecked (False)</li>
                            <li>Password: Use an <strong>App Password</strong>, not your main password. You must have 2FA enabled in your Google account to create one.</li>
                        </ul>
                        <p><strong>For Hostinger / cPanel:</strong></p>
                        <ul style="padding-left: 20px;">
                            <li>Host: mail.yourdomain.com OR smtp.hostinger.com</li>
                            <li>Port: 465 (Secure: Checked) OR 587 (Secure: Unchecked)</li>
                            <li>Password: Your email account password</li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <script>
        document.getElementById('saveBtn').addEventListener('click', async () => {
            const btn = document.getElementById('saveBtn');
            const status = document.getElementById('statusMsg');
            
            btn.innerHTML = 'Saving...';
            btn.disabled = true;

            const data = {
                host: document.getElementById('host').value,
                port: document.getElementById('port').value,
                username: document.getElementById('username').value,
                password: document.getElementById('password').value,
                from_email: document.getElementById('from_email').value,
                secure: document.getElementById('secure').checked
            };

            try {
                const res = await fetch('/api/smtp-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                
                status.textContent = result.message;
                status.style.color = result.success ? '#22c55e' : '#ef4444';
            } catch (err) {
                status.textContent = 'Error saving settings';
                status.style.color = '#ef4444';
            } finally {
                btn.innerHTML = 'Save Settings';
                btn.disabled = false;
            }
        });

        document.getElementById('testBtn').addEventListener('click', async () => {
            const btn = document.getElementById('testBtn');
            const status = document.getElementById('statusMsg');
            
            btn.innerHTML = 'Sending...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/test-smtp', { method: 'POST' });
                const result = await res.json();
                
                status.textContent = result.message;
                status.style.color = result.success ? '#22c55e' : '#ef4444';
            } catch (err) {
                status.textContent = 'Error testing SMTP';
                status.style.color = '#ef4444';
            } finally {
                btn.innerHTML = 'Send Test Email';
                btn.disabled = false;
            }
        });
    </script>
</body>
</html>
